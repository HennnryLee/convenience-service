# 便民服务平台 Nginx 反向代理示例
# 用法：替换 example.com / 证书路径 / 项目路径后放入 /etc/nginx/conf.d/convenience.conf
# 注意：应用自身已设置 CSP、X-Frame-Options、Referrer-Policy 等安全头，Nginx 不要重复覆盖。

upstream convenience_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # 本站只有文本表单；与 Flask MAX_CONTENT_LENGTH（1 MB）保持一致并略留余量
    client_max_body_size 2m;

    # 静态资源由 Nginx 直出，减少 Python 进程压力
    location /static/ {
        alias /srv/convenience_service/app/static/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://convenience_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
    }
}
