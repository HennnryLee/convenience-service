# 复制为 .env 后按需修改；不要提交真实密钥。
# 生产环境必须设置随机 SECRET_KEY（python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=change-me-in-production
FLASK_CONFIG=development

# 默认 SQLite；切换 MySQL 时取消注释并填写账号密码
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/convenience?charset=utf8mb4

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
